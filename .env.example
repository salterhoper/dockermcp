# Copy to .env and fill in. Generate each secret with:
#   openssl rand -base64 32

# Seals every stored credential (SSH keys, sudo/registry passwords, deploy env).
# Losing or changing this makes existing credentials permanently unreadable.
APP_ENCRYPTION_KEY=

# Signs session cookies. Rotating it logs everyone out.
SESSION_SECRET=

# Database configuration:
# PostgreSQL is optional! If DATABASE_URL is unset, dockdeploy defaults to
# embedded SQLite (stored at dockdeploy.db or SQLITE_PATH).
#
# When running with Docker Compose, SQLite is stored in the dockdeploy-data volume.
# SQLITE_PATH=/home/app/data/dockdeploy.db
#
# To use external PostgreSQL instead:
# DATABASE_URL=postgres://user:password@host:5432/dockdeploy?sslmode=disable

# Public URL of this dashboard. Used for webhook and invitation links, and as
# the OAuth issuer / redirect base for MCP OAuth (must be https in production).
APP_URL=http://localhost:8081
PORT=8081

# --- Google-backed MCP OAuth (optional) ---------------------------------
# When both are set, the /api/mcp endpoint advertises OAuth 2.1 so Gemini (or
# any spec MCP client) can self-register, authenticate the user with Google,
# and obtain an access token. Leave blank to keep the MCP endpoint on plain
# API-token auth only.
#
# Create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   {APP_URL}/api/auth/google/callback
# e.g. https://dc.codesky.tech/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional comma-separated allowlist of verified Google email domains. The email
# must already belong to a dockdeploy user regardless; this is an extra gate.
# MCP_OAUTH_ALLOWED_DOMAINS=codesky.tech
# Lifetime in days of the access token minted by the OAuth flow (0 = never).
# MCP_OAUTH_TOKEN_TTL_DAYS=90

# Bind to 127.0.0.1 by default; put a reverse proxy with TLS in front before
# exposing this to the internet.
BIND_ADDR=127.0.0.1
HOST_PORT=8081

APP_ENV=production
LOG_LEVEL=info
